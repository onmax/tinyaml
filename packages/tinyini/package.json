{
  "name": "tinyini",
  "version": "0.0.0",
  "description": "Tiny, fast INI parser and stringifier, with drop-in replacements for ini and @one-ini/wasm",
  "keywords": [
    "config",
    "editorconfig",
    "gitconfig",
    "ini",
    "npmrc",
    "one-ini",
    "parser",
    "stringify"
  ],
  "homepage": "https://github.com/onmax/tiny/tree/main/packages/tinyini#readme",
  "bugs": "https://github.com/onmax/tiny/issues",
  "license": "MIT",
  "author": "onmax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/tiny.git",
    "directory": "packages/tinyini"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "package.json": [
        "./package.json"
      ],
      "ini": [
        "./dist/ini.d.mts"
      ],
      "ini-v2": [
        "./dist/ini-v2.d.mts"
      ],
      "ini-v1": [
        "./dist/ini-v1.d.mts"
      ],
      "one-ini": [
        "./dist/one-ini.d.mts"
      ],
      "one-ini-v0.1": [
        "./dist/one-ini-v0.1.d.mts"
      ],
      "*": [
        "./dist/index.d.mts"
      ]
    }
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./ini": "./dist/ini.mjs",
    "./ini-v2": "./dist/ini-v2.mjs",
    "./ini-v1": "./dist/ini-v1.mjs",
    "./one-ini": "./dist/one-ini.mjs",
    "./one-ini-v0.1": "./dist/one-ini-v0.1.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "typecheck": "tsrs --noEmit",
    "test": "vp test",
    "test:dist": "vp test run --config test/dist.config.ts",
    "check": "vp check && pnpm typecheck",
    "ready": "vp fmt && pnpm build && pnpm check && pnpm test",
    "prepare": "vp config",
    "ini-tests": "node scripts/ini-tests.ts",
    "fuzz": "node scripts/fuzz.ts",
    "fuzz:stringify": "node scripts/fuzz-stringify.ts",
    "size": "node scripts/size.ts",
    "bench": "node bench/index.ts",
    "versions": "node scripts/versions.ts",
    "editorconfig-tests": "node scripts/editorconfig-tests.ts",
    "one-ini-fuzz": "node scripts/one-ini-fuzz.ts"
  },
  "devDependencies": {
    "@one-ini/wasm": "0.2.1",
    "@types/node": "^26.6.6",
    "editorconfig": "3.0.2",
    "editorconfig-v1": "npm:editorconfig@1.0.4",
    "esbuild": "^0.28.2",
    "ini": "7.0.0",
    "ini-v1": "npm:ini@1.3.8",
    "ini-v2": "npm:ini@2.0.0",
    "one-ini-v0.1": "npm:@one-ini/wasm@0.1.1",
    "publint": "^0.3.25",
    "tcompare": "5.0.7",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "^7.0.2",
    "vite-plus": "^1.4.0"
  },
  "engines": {
    "node": ">=22"
  }
}

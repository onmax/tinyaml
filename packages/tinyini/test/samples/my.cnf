[client]
port		= 3306
socket		= /var/run/mysqld/mysqld.sock
password	= 'p@ss;word#1'

[mysqld_safe]
nice		= 0

[mysqld]
user		= mysql
bind-address	= 127.0.0.1
key_buffer_size		= 16M
max_allowed_packet	= 64M
skip-external-locking
skip-name-resolve
sql_mode = "STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION"
!includedir /etc/mysql/conf.d/

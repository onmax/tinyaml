{
  "name": "tiny",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "ready": "pnpm -r ready",
    "size": "pnpm -r size",
    "bench": "pnpm -r bench",
    "charts": "pnpm fixtures && node --no-warnings .github/scripts/charts.ts",
    "brand": "node --no-warnings .github/scripts/brand.ts",
    "fixtures": "pnpm --filter tinyaml fixtures && (test -d packages/tinyjson5/.cache/json5-2.2.3 || pnpm --filter tinyjson5 json5:fetch)",
    "docs:dev": "pnpm --filter tiny-docs dev",
    "docs:generate": "pnpm --filter tiny-docs generate"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "comark": "^0.8.1",
    "comark-charts": "^0.7.4",
    "wrangler": "^4.156.0"
  }
}

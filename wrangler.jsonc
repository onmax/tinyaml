{
  "name": "tiny",
  // Nitro's output, from `pnpm docs:generate`. The build merges this file with ViteHub's into
  // docs/dist/server/wrangler.json and points .wrangler/deploy/config.json at it, so `wrangler deploy` from here
  // deploys that one. .github/workflows/docs.yml runs both on every push to main.
  "main": "docs/dist/server/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The Worker runs first so the old host can redirect before an asset answers. Nitro's middleware then serves the
  // prerendered file through ASSETS (docs/server/middleware/site.ts).
  "assets": { "directory": "./docs/dist/public", "binding": "ASSETS", "run_worker_first": true },
  // tiny.onmax.me and tinyaml.onmax.me are attached to the Worker as custom domains in Cloudflare, not listed here as
  // routes, so the deploy token needs no zone permissions. A deploy leaves them in place.
  "workers_dev": false,
}
